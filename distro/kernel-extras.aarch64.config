# Kernel config fragment applied on top of arm64 defconfig.
# Mirrors kernel-extras.config (x86_64) with aarch64 virt machine additions.

# ── 9p filesystem (host directory mounts via QEMU -virtfs) ───────────────────
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

# ── VirtIO infrastructure ─────────────────────────────────────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
# ARM virt machine uses MMIO bus in addition to PCIe
CONFIG_VIRTIO_MMIO=y

# ── Kernel-side DHCP (ip=dhcp kernel arg; avoids needing udhcpc in /init) ────
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# ── FUSE filesystem (required for /agents virtual filesystem, p3.1) ───────────
CONFIG_FUSE_FS=y

# ── Landlock LSM (required for p3.3 MCP server filesystem sandboxing) ─────────
CONFIG_SECURITY_LANDLOCK=y

# ── seccomp-bpf (required for p3.3 seccomp filter; DenySpawn is x86_64-only) ──
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ── Linux namespaces (required for p4.2 IsolateNetwork / IsolateMount rules) ──
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y

# ── PL011 UART (console=ttyAMA0 on QEMU virt machine) ────────────────────────
# Without PL011 console enabled, the guest boots silently (no output).
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
