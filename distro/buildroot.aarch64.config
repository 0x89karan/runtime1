# AgentOS Buildroot defconfig — aarch64
# Usage: this file is fed to `make defconfig BR2_DEFCONFIG=...` by distro/Makefile.
# $(BR2_EXTERNAL_AGENTOS_PATH) is substituted by Buildroot to the absolute path of distro/.
# Diff from buildroot.config: BR2_aarch64, defconfig, BR2_LINUX_KERNEL_IMAGE.
# (Package set is kept IN SYNC with buildroot.config — python3 + openssl are required
# for the Python MCP sidecars; omitting them made the flagship CoS non-functional on
# arm64, AUDIT-v0.97 P1-1.)

# ── Target architecture ───────────────────────────────────────────────────────
BR2_aarch64=y

# ── Toolchain: internal musl ──────────────────────────────────────────────────
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y

# ── System ────────────────────────────────────────────────────────────────────
BR2_TARGET_GENERIC_HOSTNAME="agentos"
BR2_TARGET_GENERIC_ISSUE=""
BR2_INIT_NONE=y

# ── Rootfs overlay ────────────────────────────────────────────────────────────
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AGENTOS_PATH)/overlay"

# ── Packages ──────────────────────────────────────────────────────────────────
BR2_PACKAGE_BUSYBOX=y
# Python3 + OpenSSL: needed to run the stdlib-only Python MCP sidecars in the VM.
# oauth_mcp.py uses `import ssl` for HTTPS calls to Google APIs — requires OpenSSL.
# MUST stay in sync with buildroot.config (AUDIT-v0.97 P1-1: their absence made every
# sidecar unrunnable on arm64 → the flagship never produced a brief).
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_OPENSSL=y

# ── Linux kernel ─────────────────────────────────────────────────────────────
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_LTS_VERSION=y
BR2_LINUX_KERNEL_DEFCONFIG="defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AGENTOS_PATH)/kernel-extras.aarch64.config"
BR2_LINUX_KERNEL_IMAGE=y

# ── Build acceleration ────────────────────────────────────────────────────────
# ccache cuts toolchain rebuild time from ~30 min to ~2 min on repeated clean
# builds. Cache stored in ~/.buildroot-ccache (shared across worktrees).
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.buildroot-ccache"

# ── Rootfs format: initramfs only ────────────────────────────────────────────
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
