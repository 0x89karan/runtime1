#!/bin/sh
# AgentOS /init — PID 1.
# Mounts virtual filesystems, loads secrets from the host via 9p, starts agentd.
# agentd becomes the new PID 1 after exec; kernel panics (cleanly) when it exits.

set -e

# Sentinel read by the CI smoke test — proves init ran (not just the kernel).
echo "AGENTOS_INIT_STARTED"

mount -t proc    none /proc
mount -t sysfs   none /sys
mount -t devtmpfs none /dev 2>/dev/null || mdev -s

mkdir -p /run/secrets /run/output /run/memory

# Mount host-shared directories injected by QEMU -virtfs.
mount -t 9p -o trans=virtio,version=9p2000.L,ro secrets0 /run/secrets || {
    echo "ERROR: failed to mount secrets0 via 9p." >&2
    echo "       Is -virtfs local,...,mount_tag=secrets0 in the QEMU command?" >&2
    exec sh
}

mount -t 9p -o trans=virtio,version=9p2000.L output0 /run/output || {
    echo "ERROR: failed to mount output0 via 9p." >&2
    exec sh
}

mount -t 9p -o trans=virtio,version=9p2000.L memory0 /run/memory || {
    echo "ERROR: failed to mount memory0 via 9p." >&2
    echo "       Is -virtfs ...,mount_tag=memory0 in the QEMU command?" >&2
    exec sh
}

# Load secrets. agentos.env must set ANTHROPIC_API_KEY (and any other vars).
# Parse KEY=value directly — do not shell-source the file (prevents code execution
# from a malformed secrets file, consistent with the Docker entrypoint parser).
if [ ! -f /run/secrets/agentos.env ]; then
    echo "ERROR: /run/secrets/agentos.env not found." >&2
    echo "       Create ~/.agentos-secrets/agentos.env with:" >&2
    echo "         ANTHROPIC_API_KEY=sk-ant-..." >&2
    exec sh
fi

while IFS= read -r _ln || [ -n "$_ln" ]; do
    case "$_ln" in ''|'#'*) continue ;; esac
    _k="${_ln%%=*}"
    _v="${_ln#*=}"
    case "$_k" in *[!A-Za-z0-9_]*|''|[0-9]*) continue ;; esac
    case "$_k" in BASH_ENV|LD_PRELOAD|LD_LIBRARY_PATH|PATH|IFS|ENV|PS4|CDPATH) continue ;; esac
    case "$_k" in PYTHONSTARTUP|PYTHONPATH|PYTHONUSERSITE|PYTHONINSPECT|RUBYOPT|NODE_OPTIONS) continue ;; esac
    export "${_k}=${_v}"
done < /run/secrets/agentos.env

if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "ERROR: ANTHROPIC_API_KEY not set in agentos.env" >&2
    exec sh
fi

# agentd writes flight.jsonl to its cwd; /run/output is the host-visible mount.
cd /run/output

# Select agentd config from kernel cmdline (agentd.config=<path>), fallback to agent.toml.
# The systemd service unit passes agentd.config=/etc/agentd/cos.agents.toml via -append.
# 'make run' and 'make test' pass no agentd.config= so they use the default agent.toml.
_CFG=$(tr ' ' '\n' < /proc/cmdline | grep '^agentd\.config=' | head -1 | cut -d= -f2-)
_CFG="${_CFG:-/etc/agentd/agent.toml}"

exec /usr/bin/agentd "$_CFG"
