# AgentOS Buildroot defconfig
# Usage: this file is fed to `make defconfig BR2_DEFCONFIG=...` by distro/Makefile.
# $(BR2_EXTERNAL_PATH) is substituted by Buildroot to the absolute path of distro/.

# ── Target architecture ───────────────────────────────────────────────────────
BR2_x86_64=y

# ── Toolchain: internal musl ──────────────────────────────────────────────────
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y

# ── System ────────────────────────────────────────────────────────────────────
BR2_TARGET_GENERIC_HOSTNAME="agentos"
BR2_TARGET_GENERIC_ISSUE=""
BR2_INIT_NONE=y

# ── Rootfs overlay ────────────────────────────────────────────────────────────
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PATH)/overlay"

# ── Packages ──────────────────────────────────────────────────────────────────
BR2_PACKAGE_BUSYBOX=y

# ── Linux kernel ─────────────────────────────────────────────────────────────
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_LTS_VERSION=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PATH)/kernel-extras.config"
BR2_LINUX_KERNEL_BZIMAGE=y

# ── Rootfs format: initramfs only ────────────────────────────────────────────
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
