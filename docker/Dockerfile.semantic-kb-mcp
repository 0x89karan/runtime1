FROM python:3.12-slim
WORKDIR /app
COPY docker/semantic_kb_mcp.py .
EXPOSE 8020
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8020/healthz')" || exit 1
CMD ["python3", "semantic_kb_mcp.py"]
