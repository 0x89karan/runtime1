# Copy to .env — Docker Compose picks it up automatically.
#
# Uncomment to use a pre-built local image instead of building from source.
# Run `make dev-image` first to build it.
# AGENTOS_IMAGE=agentos:dev
#
# Uncomment to use the published multi-arch image instead.
# AGENTOS_IMAGE=ghcr.io/0x89karan/runtime1:full
